#!/bin/sh
# OpenSCAD draws PNGs with OpenGL, which needs an X display even from the command line. When there
# is none, as in a container or a CI job, this runs it on a virtual one for the length of the
# command: Xvfb, drawn by Mesa in software.
if [ -n "${DISPLAY:-}" ]; then
  exec /usr/bin/openscad "$@"
fi
exec xvfb-run --auto-servernum --server-args="-screen 0 1920x1080x24 -nolisten tcp" \
  /usr/bin/openscad "$@"
